{
  "name": "bookwheel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bookwheel \"vitest run tests/rules\"",
    "test:e2e": "playwright test --project=demo",
    "test:e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-bookwheel \"playwright test --project=emulator\""
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "firebase-tools": "^15.31.0",
    "svelte": "^5.57.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
